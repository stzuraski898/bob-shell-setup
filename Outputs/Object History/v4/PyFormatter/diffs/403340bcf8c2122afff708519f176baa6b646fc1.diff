+  /// Convert entire data structure to read-only once
+  void convert_to_readonly() {
+    PyObject* readonly_root = make_immutable(root);
+
+    if (readonly_root != root) {
+      Py_DECREF(root);
+      root = readonly_root;
+      cursor = root;
