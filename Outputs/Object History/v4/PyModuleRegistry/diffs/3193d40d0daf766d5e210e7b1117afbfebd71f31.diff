+void PyModuleRegistry::handle_config(const std::string &k, const std::string &v)
+{
+  Mutex::Locker l(module_config.lock);
+
+  if (!v.empty()) {
+    module_config.config[k] = v;
+  } else {
+    module_config.config.erase(k);
+  }
+}
