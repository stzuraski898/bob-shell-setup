+namespace {
+
+bool is_limited(const std::map<OSDPerfMetricQueryID,
+                                std::optional<OSDPerfMetricLimit>> &limits) {
+  for (auto &it : limits) {
+    if (!it.second) {
+      return false;
+    }
+  }
+  return true;
+}
+
+} // anonymous namespace
