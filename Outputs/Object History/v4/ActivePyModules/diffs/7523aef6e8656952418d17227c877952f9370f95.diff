     f.open_object_section("i");
     f.open_array_section("k");
     for (auto &sub_key : key) {
@@ -1090,6 +1150,7 @@ PyObject *ActivePyModules::get_osd_perf_counters(MetricQueryID query_id)
     f.close_section(); // i
   }
   f.close_section(); // counters
+  f.close_section(); // metrics
 
   return f.get();
 }
